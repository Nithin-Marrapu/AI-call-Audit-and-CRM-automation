# LeadSquared (Settings > API and Webhooks)
LEADSQUARED_HOST=https://api-in21.leadsquared.com/v2
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=
# header (default, keys stay out of URLs) or query
LEADSQUARED_AUTH_MODE=header

# Local models
PYTHON_BIN=./whisper-env/bin/python
# mlx (Mac GPU, recommended) or openai
WHISPER_BACKEND=mlx
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# en, auto, hi, te ...
WHISPER_LANGUAGE=en
# Optional: override the domain vocabulary hint (empty = none)
# WHISPER_PROMPT=
# Set to false to skip the 16 kHz resample + noise filter
AUDIO_PREPROCESS=true
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
LLM_MAX_TOKENS=1000

# Where the job database and per-call files live
DATA_DIR=./data
# Stop auto-processing a call after this many failures
MAX_ATTEMPTS=3

# Lead note format: html (bold + bullets in LeadSquared) or text
NOTE_FORMAT=html

# Only audit calls at least this long (minutes)
MIN_CALL_MINUTES=7

# LeadSquared call activity codes to audit: 21 = inbound, 22 = outbound
CALL_EVENT_CODES=21,22
